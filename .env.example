APP_ENV=development
APP_PORT=8000

POSTGRES_DB=assistant_db
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=assistant_password
DATABASE_URL=postgresql+asyncpg://assistant_user:assistant_password@postgres:5432/assistant_db

REDIS_URL=redis://redis:6379/0

CHROMA_HOST=chroma
CHROMA_PORT=8000

NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=assistant_neo4j_password

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=google/gemini-2.5-pro
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_VERIFICATION_MODEL=google/gemini-2.5-flash

SESSION_COOKIE_NAME=chat_session_id
CONSENT_COOKIE_NAME=chat_consent

# Admin auth (HTTP Basic) — protects all /admin/* routes and /api/agent-runs*.
# Generate a hash: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional second admin account (reviewer role) — same mechanism, but restricted to a fixed
# subset of Evaluation sub-tabs (Overview/Log Teknis/ACIF Traces/Retrieval only; see
# security.py's EVALUATION_TABS_SECOND_ADMIN). Leave both empty to disable.
SECOND_ADMIN_USERNAME=
SECOND_ADMIN_PASSWORD_HASH=

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_PER_IP_PER_MINUTE=60
MAX_LLM_CALLS_PER_SESSION_PER_DAY=50

REQUEST_QUEUE_MAX_SIZE=500
LLM_MAX_CONCURRENCY=25

EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=15
RAG_TOP_K_BROAD=20
GRAPH_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_TOKENS=4000

RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TIMEOUT_SECONDS=8

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

ACIF_ENABLED=true
ACIF_STRICT_MODE=true
ACIF_INPUT_REJECT_THRESHOLD=0.25
ACIF_INPUT_CAUTION_THRESHOLD=0.10
ACIF_GATE1_SEMANTIC_ENABLED=true
ACIF_GATE1_SEMANTIC_CAUTION_SIMILARITY=0.50
ACIF_GATE1_SEMANTIC_REJECT_SIMILARITY=0.72
ACIF_GATE1_SEMANTIC_TIMEOUT_SECONDS=3.0
ACIF_CONTEXT_KEEP_THRESHOLD=0.75
ACIF_CONTEXT_VERIFY_THRESHOLD=0.50
ACIF_CONTEXT_MIN_THRESHOLD=0.35
ACIF_CONTEXT_EXACT_TERM_BONUS=0.05
ACIF_CONTEXT_SECTION_MATCH_BONUS=0.05
ACIF_MAX_SELECTED_CONTEXTS=3
ACIF_GRAPH_SUPPORT_MIN=0.40
ACIF_MAX_PROMPT_INPUT_TOKENS=4500
ACIF_GROUNDING_VERIFIED_THRESHOLD=0.80
ACIF_GROUNDING_FALLBACK_THRESHOLD=0.60
ACIF_REQUIRE_CITATION=true
ACIF_REGENERATE_ON_UNSUPPORTED=true

OPENROUTER_DAILY_BUDGET_USD=10
OPENROUTER_MONTHLY_BUDGET_USD=150

# Evaluation Layer (Phase 1 — technical/ACIF observability logging on the /chat pipeline)
EVALUATION_ENABLED=true
EVALUATION_LOGGING_ENABLED=true
EVALUATION_MODE_PUBLIC=false
EVALUATION_LOG_FULL_ANSWER=true
EVALUATION_LOG_FULL_CONTEXT=false
EVALUATION_RETENTION_DAYS=90
EVALUATION_UI_ENABLED=true
EVALUATION_EXPORT_ENABLED=true
EVALUATION_EXPORT_MAX_ROWS=50000
EVALUATION_RUNNER_ENABLED=true
EVALUATION_RUNNER_CONCURRENCY=3
EVALUATION_RUNNER_TIMEOUT_SECONDS=90
EVALUATION_LLM_JUDGE_ENABLED=false
ASQ_ENABLED=true
SUS_ENABLED=true

# ACIF Observability (safe, per-gate audit trail — never raw prompts/formulas/secrets)
ACIF_OBSERVABILITY_ENABLED=true
ACIF_ADMIN_TRACE_ENABLED=true
ACIF_SHOW_INTERNAL_FORMULA=false
ACIF_SHOW_RAW_PROMPT=false

# Document upload & storage
MAX_UPLOAD_FILE_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,html
RAW_DOCUMENT_STORAGE_PATH=data/raw
PROCESSED_DOCUMENT_STORAGE_PATH=data/processed

# Chunking & vision extraction (image/table_image chunks — CLAUDE.md §38)
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
CHUNK_SUMMARY_ENABLED=true
CHUNK_SUMMARY_MODEL=google/gemini-2.5-flash
CHUNK_SUMMARY_MAX_TOKENS=400
VISION_EXTRACTION_ENABLED=true

# Official document sync worker (CLAUDE.md §21.2/§21.8)
DOCUMENT_SYNC_ENABLED=true
DOCUMENT_SYNC_SOURCE_URL=https://sipenmaru.poltekkesjogja.ac.id/index.php?mod=login_default&sub=filePanduan&act=view&typ=html
DOCUMENT_SYNC_INTERVAL_HOURS=24
DOCUMENT_SYNC_TIMEOUT_SECONDS=30
DOCUMENT_SYNC_USER_AGENT=campus-virtual-assistant-sync/1.0
